# BYOK cloud API keys for custom_nodes/cloud_api_byok
# Copy to .env and fill values. Never commit .env.

# Alibaba DashScope (Qwen-Image / Wan video)
DASHSCOPE_API_KEY=
# Optional override (default https://dashscope.aliyuncs.com/api/v1)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Tencent Cloud Hunyuan image (TC3 SecretId / SecretKey)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Optional (default ap-guangzhou)
# TENCENT_REGION=ap-guangzhou

# OpenAI Images API or compatible gateway / TokenHub chat
OPENAI_API_KEY=
# Optional (default https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tencent TokenHub Hy-Image (hy-image-v3 wand). Reuses OPENAI_API_KEY if unset.
# TOKENHUB_API_KEY=
# TOKENHUB_BASE_URL=https://tokenhub-intl.tencentmaas.com/v1


# ComfyUI main.py extra args (optional)
# CLI_ARGS=
